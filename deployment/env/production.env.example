# DxCon production deployment environment (TEMPLATE ONLY).
# Copy to an untracked local file before starting Compose:
#   cp deployment/env/production.env.example deployment/env/production.env
# Then replace every placeholder with cryptographically strong values.
# Never commit deployment/env/production.env.
#
# POSTGRES_PASSWORD must match the password embedded in DATABASE_URL.
# If the postgres Docker volume was already initialized, changing
# POSTGRES_PASSWORD in this file alone does NOT rotate the DB password —
# run ALTER USER inside Postgres (or restore from backup) instead of
# deleting volumes.
#
# Cutover notes (P0-9):
# - No external secret manager is wired; production must inject secrets via
#   env_file / orchestrator secrets (Docker/K8s/cloud). Do not commit secrets.
# - Set EMAIL_DRY_RUN=false only when real SMTP credentials are configured.
# - Enable TLS via deployment/nginx/https.conf.example + docker-compose.production.tls.yml
#   after provisioning real certificates (never self-signed for public cutover).
# - Redis has no requirepass in default compose (internal Docker network only).
#   Add REDIS auth before exposing Redis beyond the compose network.
APP_ENV=production
SECRET_KEY=replace-with-production-secret-min-32-chars
JWT_SECRET_KEY=replace-with-production-jwt-secret-min-32-chars
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://dxcon:replace-me@postgres:5432/dxcon
REDIS_URL=redis://redis:6379/0
QUEUE_PROVIDER=redis
CORS_ORIGINS=https://dxcon.com.vn,https://www.dxcon.com.vn,https://app.dxcon.com.vn,https://admin.dxcon.com.vn,https://doctor.dxcon.com.vn,https://patient.dxcon.com.vn,https://lab.dxcon.com.vn,https://clinic.dxcon.com.vn,https://collector.dxcon.com.vn
PUBLIC_SITE_URL=https://dxcon.com.vn
WEB_APP_URL=https://app.dxcon.com.vn
API_BASE_URL=https://api.dxcon.com.vn
DEMO_MODE=false
# Local durable proof may use EMAIL_DRY_RUN=true. Public cutover requires false + real SMTP.
EMAIL_DRY_RUN=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=dxcon-prod
SMTP_PASSWORD=replace-me
SMTP_FROM=noreply@dxcon.com
SMTP_USE_TLS=true
STORAGE_PATH=/var/lib/dxcon/uploads
STORAGE_BACKEND=local
LOG_LEVEL=INFO
LOG_FORMAT=json
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=https
BUILD_VERSION=1.0.0-rc2
GIT_SHA=local
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
STARTUP_VALIDATE_DB=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
