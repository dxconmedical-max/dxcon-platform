APP_ENV=production
SECRET_KEY=replace-with-production-secret-min-32-chars
JWT_SECRET_KEY=replace-with-production-jwt-secret-min-32-chars
DATABASE_URL=postgresql://dxcon:replace-me@postgres:5432/dxcon
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=https://dxcon.com.vn,https://www.dxcon.com.vn,https://app.dxcon.com.vn
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=dxcon-prod
SMTP_PASSWORD=replace-me
SMTP_FROM=noreply@dxcon.com
SMTP_USE_TLS=true
STORAGE_PATH=/var/lib/dxcon/uploads
STORAGE_BACKEND=local

LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID

BUILD_VERSION=1.0.0-rc2
GIT_SHA=local
BUILD_TIME=

WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=280
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY_SECONDS=2
STARTUP_VALIDATE_DB=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

CACHE_DEFAULT_TTL_SECONDS=60
SLOW_QUERY_THRESHOLD_MS=100
BACKGROUND_TASK_WORKERS=8
